# E2E Test Environment — http://localhost:3100
# Used by Playwright smoke + full test suites via Docker Compose e2e profile
# Copy to .env.local and fill in secrets for local E2E runs

# ─── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100
NODE_ENV=test

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL on e2e profile port (dev=5432, e2e=5532)
DATABASE_URL=postgresql://postgres:postgres@localhost:5532/saas_e2e

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis on e2e profile port (dev=6379, e2e=6479)
REDIS_URL=redis://localhost:6479

# ─── Auth (Better-Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3100

# ─── OAuth providers ───────────────────────────────────────────────────────────
# E2E uses test credentials — see tests/e2e/README.md for details
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
# E2E uses Stripe test mode — use test API keys
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ID_PRO_MONTHLY=price_
STRIPE_PRICE_ID_PRO_ANNUAL=price_
STRIPE_PRICE_ID_ADVANCED_MONTHLY=price_
STRIPE_PRICE_ID_ADVANCED_ANNUAL=price_

# ─── Email ─────────────────────────────────────────────────────────────────────
# Mailhog on e2e profile ports (dev=1025/8025, e2e=1125/8125)
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost
RESEND_API_KEY=

# ─── GrowthBook (Feature Flags) ───────────────────────────────────────────────
GROWTHBOOK_API_KEY=

# ─── Observability ──────────────────────────────────────────────────────────────
GLITCHTIP_DSN=

# ─── Port Offset Convention ────────────────────────────────────────────────────
# dev profile:  postgres=5432, redis=6379, smtp=1025, mailhog-ui=8025, app=3000
# e2e profile:  postgres=5532, redis=6479, smtp=1125, mailhog-ui=8125, app=3100
