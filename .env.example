# ─── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for local dev
# Format: postgresql://{user}:{password}@{host}:{port}/{database}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/saas_test
DATABASE_URL_E2E=postgresql://postgres:postgres@localhost:5532/saas_e2e
# Admin URL connects to the default 'postgres' DB — used by create-test-db.ts
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for: sessions, rate limiting, BullMQ, feature flag cache
REDIS_URL=redis://localhost:6379

# ─── Auth (Better-Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ─── OAuth providers ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtain from: console.cloud.google.com → Credentials

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Obtain from: github.com → Settings → Developer Settings → OAuth Apps

# ─── Billing (Stripe) ──────────────────────────────────────────────────────────
# Use Stripe test mode keys for local development
# Obtain from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Obtain webhook secret with: stripe listen --print-secret (Stripe CLI)
STRIPE_PRICE_ID_PRO_MONTHLY=price_
STRIPE_PRICE_ID_PRO_ANNUAL=price_
STRIPE_PRICE_ID_ADVANCED_MONTHLY=price_
STRIPE_PRICE_ID_ADVANCED_ANNUAL=price_

# ─── Email ─────────────────────────────────────────────────────────────────────
# Local dev uses Mailhog (SMTP trap) — no real emails sent
# Obtain Resend API key from: resend.com (production only)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost
RESEND_API_KEY=

# ─── GrowthBook (Feature Flags) ───────────────────────────────────────────────
# Obtain from: app.growthbook.com → SDK Keys
GROWTHBOOK_API_KEY=

# ─── Observability ─────────────────────────────────────────────────────────────
# Obtain from: app.glitchtip.com (self-hosted or cloud)
GLITCHTIP_DSN=
