{
  "permissions": {
    "allow": ["Bash(npx:*)", "WebSearch", "WebFetch(domain:raw.githubusercontent.com)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ]
  }
}
