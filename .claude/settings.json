{
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": ".claude/auto-memory/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR\"/CLAUDE.md \"$CLAUDE_PROJECT_DIR\"/.claude/CLAUDE.md \"$CLAUDE_PROJECT_DIR\"/AGENT.md \"$CLAUDE_PROJECT_DIR\"/.claude/memory/*.md \"$CLAUDE_PROJECT_DIR\"/.claude/auto-memory/*.md 2>/dev/null",
            "statusMessage": "Loading project memory"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR\"/CLAUDE.md \"$CLAUDE_PROJECT_DIR\"/.claude/CLAUDE.md \"$CLAUDE_PROJECT_DIR\"/AGENT.md \"$CLAUDE_PROJECT_DIR\"/.claude/memory/*.md \"$CLAUDE_PROJECT_DIR\"/.claude/auto-memory/*.md 2>/dev/null",
            "statusMessage": "Re-injecting project memory after compaction"
          }
        ]
      }
    ]
  }
}
