{
  "name": "gas-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/wait-for-it.sh localhost:5432 localhost:6379 -- next dev",
    "dev:services": "docker compose --profile dev up -d",
    "dev:services:watch": "docker compose --profile dev up",
    "dev:stop": "docker compose --profile dev down",
    "dev:clean": "docker compose --profile dev down -v",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
