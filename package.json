{
  "name": "gas-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/wait-for-it.sh localhost:5432 localhost:6379 -- next dev",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:watch": "docker compose -f docker-compose.dev.yml up",
    "dev:services:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:services:clean": "docker compose -f docker-compose.dev.yml down -v",
    "test:e2e:services": "docker compose -f docker-compose.e2e.yml up -d",
    "test:e2e:services:stop": "docker compose -f docker-compose.e2e.yml down",
    "test:e2e:services:clean": "docker compose -f docker-compose.e2e.yml down -v",
    "test:container:services": "docker compose -f docker-compose.container.yml up -d",
    "test:container:services:stop": "docker compose -f docker-compose.container.yml down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "test:unit": "echo 'No unit tests yet (E4+)' && exit 0",
    "test:integration": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "setup:test": "tsx scripts/create-test-db.ts",
    "test:migrations": "bash scripts/test-migrations.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --check"
    ],
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ],
    "*.{json,css,md}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "next": "^16.2.2",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
